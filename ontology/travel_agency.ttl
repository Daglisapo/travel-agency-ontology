#  ΣΤΙΓΜΙΟΤΥΠΑ (Individuals)
# =====================================================================

# ---------- Γλώσσες, καταστάσεις κράτησης, κανάλια ----------
:Greek   a owl:NamedIndividual , :Language ; :name "Ελληνικά" .
:English a owl:NamedIndividual , :Language ; :name "English" .
:Italian a owl:NamedIndividual , :Language ; :name "Italiano" .
:French  a owl:NamedIndividual , :Language ; :name "Français" .

:Confirmed a owl:NamedIndividual , :BookingStatus ; rdfs:label "Επιβεβαιωμένη"@el .
:Pending   a owl:NamedIndividual , :BookingStatus ; rdfs:label "Σε αναμονή"@el .
:Cancelled a owl:NamedIndividual , :BookingStatus ; rdfs:label "Ακυρωμένη"@el .

:SocialMedia   a owl:NamedIndividual , :AdvertisingChannel ; :name "Social media (Facebook / Instagram)" .
:AgencyWebsite a owl:NamedIndividual , :AdvertisingChannel ; :name "Ιστότοπος πρακτορείου" .
:Newsletter    a owl:NamedIndividual , :AdvertisingChannel ; :name "Email newsletter" .
:RadioSpot     a owl:NamedIndividual , :AdvertisingChannel ; :name "Ραδιοφωνικό σποτ" .
:TravelFair    a owl:NamedIndividual , :AdvertisingChannel ; :name "Τουριστική έκθεση" .

[] a owl:AllDifferent ;
   owl:distinctMembers ( :Greek :English :Italian :French
                         :Confirmed :Pending :Cancelled
                         :SocialMedia :AgencyWebsite :Newsletter :RadioSpot :TravelFair ) .

# ---------- Πρακτορείο και υποκαταστήματα ----------
:AegeanHorizons a owl:NamedIndividual , :TravelAgency ;
    :name "Aegean Horizons Travel" ;
    :hasBranch :ThessalonikiBranch , :AthensBranch .

:ThessalonikiBranch a owl:NamedIndividual , :AgencyBranch ;
    :name "Υποκατάστημα Θεσσαλονίκης" ;
    :branchOf :AegeanHorizons ;
    :locatedIn :Thessaloniki .

:AthensBranch a owl:NamedIndividual , :AgencyBranch ;
    :name "Υποκατάστημα Αθήνας" ;
    :branchOf :AegeanHorizons ;
    :locatedIn :Athens .

