<owl:Class rdf:about="#VIPCustomer">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Customer"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#loyaltyPoints"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1000</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment xml:lang="el">Ορισμένη κλάση: πελάτης με τουλάχιστον 1000 πόντους επιβράβευσης. Τα μέλη της συνάγονται από τον reasoner.</rdfs:comment>
  <rdfs:label xml:lang="en">VIP Customer</rdfs:label>
  <rdfs:label xml:lang="el">Πελάτης VIP</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#IslandPackage">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#HolidayPackage"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasDestination"/>
          <owl:someValuesFrom rdf:resource="#IslandDestination"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="el">Νησιωτικό Πακέτο</rdfs:label>
  <rdfs:label xml:lang="en">Island Package</rdfs:label>
  <rdfs:comment xml:lang="el">Ορισμένη κλάση: πακέτο με τουλάχιστον έναν νησιωτικό προορισμό.</rdfs:comment>
</owl:Class>

