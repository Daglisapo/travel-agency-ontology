<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency"
         xmlns="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#"
         xmlns:dc="http://purl.org/dc/elements/1.1/">

<owl:Ontology rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency">
  <dc:title xml:lang="el">Οντολογία Ταξιδιωτικού Πρακτορείου</dc:title>
  <dc:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apostolos Dagklis (2021031)</dc:creator>
  <rdfs:comment xml:lang="en">Ontology of the structure of a travel agency: destinations, customers, holiday packages, hotels, flights, organised excursions, guides, prices, staff, bookings, payments, reviews and advertising campaigns.</rdfs:comment>
  <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.0</owl:versionInfo>
  <rdfs:comment xml:lang="el">Οντολογία της δομής ενός ταξιδιωτικού πρακτορείου: προορισμοί, πελάτες, πακέτα διακοπών, ξενοδοχεία, πτήσεις, οργανωμένες εκδρομές, οδηγοί/συνοδοί, τιμές, προσωπικό, κρατήσεις, πληρωμές, αξιολογήσεις και διαφημιστικές καμπάνιες.</rdfs:comment>
  <dc:title xml:lang="en">Travel Agency Ontology</dc:title>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#hasStatus">
  <rdfs:range rdf:resource="#BookingStatus"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Booking"/>
  <rdfs:label xml:lang="en">has status</rdfs:label>
  <rdfs:label xml:lang="el">έχει κατάσταση</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#reviews">
  <rdfs:range rdf:resource="#HolidayPackage"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Review"/>
  <rdfs:label xml:lang="el">αξιολογεί</rdfs:label>
  <rdfs:label xml:lang="en">reviews</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#promotes">
  <owl:inverseOf rdf:resource="#promotedBy"/>
  <rdfs:range rdf:resource="#HolidayPackage"/>
  <rdfs:domain rdf:resource="#MarketingCampaign"/>
  <rdfs:label xml:lang="en">promotes</rdfs:label>
  <rdfs:label xml:lang="el">προβάλλει</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasBooking">
  <rdfs:domain rdf:resource="#Customer"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <owl:inverseOf rdf:resource="#bookedBy"/>
  <rdfs:range rdf:resource="#Booking"/>
  <rdfs:label xml:lang="en">has booking</rdfs:label>
  <rdfs:label xml:lang="el">έχει κράτηση</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#locatedIn">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:range rdf:resource="#Place"/>
  <rdfs:comment xml:lang="el">Μεταβατική: αν η Οία βρίσκεται στη Σαντορίνη και η Σαντορίνη στις Κυκλάδες, τότε η Οία βρίσκεται στις Κυκλάδες. Χρησιμοποιείται για τοποθεσίες, καταλύματα και υποκαταστήματα (χωρίς domain).</rdfs:comment>
  <rdfs:label xml:lang="en">located in</rdfs:label>
  <rdfs:label xml:lang="el">βρίσκεται σε</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDestination">
  <rdfs:domain rdf:resource="#HolidayPackage"/>
  <rdfs:range rdf:resource="#Destination"/>
  <rdfs:subPropertyOf rdf:resource="#visitsPlace"/>
  <rdfs:label xml:lang="el">έχει προορισμό</rdfs:label>
  <rdfs:label xml:lang="en">has destination</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#visitsDestination">
  <rdfs:domain rdf:resource="#Excursion"/>
  <rdfs:range rdf:resource="#Destination"/>
  <rdfs:label xml:lang="en">visits destination</rdfs:label>
  <rdfs:label xml:lang="el">επισκέπτεται προορισμό</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#offeredBy">
  <rdfs:range rdf:resource="#TravelAgency"/>
  <rdfs:domain rdf:resource="#HolidayPackage"/>
  <owl:inverseOf rdf:resource="#offersPackage"/>
  <rdfs:label xml:lang="el">προσφέρεται από</rdfs:label>
  <rdfs:label xml:lang="en">offered by</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#arrivesAt">
  <rdfs:range rdf:resource="#Place"/>
  <rdfs:domain rdf:resource="#Transport"/>
  <rdfs:label xml:lang="en">arrives at</rdfs:label>
  <rdfs:label xml:lang="el">φτάνει σε</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#forPackage">
  <rdfs:domain rdf:resource="#Booking"/>
  <rdfs:range rdf:resource="#HolidayPackage"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:label xml:lang="en">for package</rdfs:label>
  <rdfs:label xml:lang="el">αφορά πακέτο</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#branchOf">
  <owl:inverseOf rdf:resource="#hasBranch"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="#TravelAgency"/>
  <rdfs:domain rdf:resource="#AgencyBranch"/>
  <rdfs:label xml:lang="el">υποκατάστημα του</rdfs:label>
  <rdfs:label xml:lang="en">branch of</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasBranch">
  <rdfs:range rdf:resource="#AgencyBranch"/>
  <rdfs:domain rdf:resource="#TravelAgency"/>
  <rdfs:label xml:lang="en">has branch</rdfs:label>
  <rdfs:label xml:lang="el">έχει υποκατάστημα</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#createdBy">
  <rdfs:domain rdf:resource="#MarketingCampaign"/>
  <rdfs:range rdf:resource="#MarketingSpecialist"/>
  <rdfs:label xml:lang="en">created by</rdfs:label>
  <rdfs:label xml:lang="el">σχεδιάστηκε από</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#speaksLanguage">
  <rdfs:range rdf:resource="#Language"/>
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:label xml:lang="en">speaks language</rdfs:label>
  <rdfs:label xml:lang="el">μιλά γλώσσα</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#includesService">
  <rdfs:domain rdf:resource="#HolidayPackage"/>
  <rdfs:range rdf:resource="#TravelService"/>
  <rdfs:label xml:lang="en">includes service</rdfs:label>
  <rdfs:label xml:lang="el">περιλαμβάνει υπηρεσία</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#departsFrom">
  <rdfs:range rdf:resource="#Place"/>
  <rdfs:domain rdf:resource="#Transport"/>
  <rdfs:label xml:lang="en">departs from</rdfs:label>
  <rdfs:label xml:lang="el">αναχωρεί από</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#bookedBy">
  <rdfs:domain rdf:resource="#Booking"/>
  <rdfs:range rdf:resource="#Customer"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:label xml:lang="el">κρατήθηκε από</rdfs:label>
  <rdfs:label xml:lang="en">booked by</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#usesChannel">
  <rdfs:domain rdf:resource="#MarketingCampaign"/>
  <rdfs:range rdf:resource="#AdvertisingChannel"/>
  <rdfs:label xml:lang="el">χρησιμοποιεί κανάλι</rdfs:label>
  <rdfs:label xml:lang="en">uses channel</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#writtenBy">
  <rdfs:range rdf:resource="#Customer"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <owl:inverseOf rdf:resource="#writesReview"/>
  <rdfs:domain rdf:resource="#Review"/>
  <rdfs:label xml:lang="el">γράφτηκε από</rdfs:label>
  <rdfs:label xml:lang="en">written by</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#operatedBy">
  <rdfs:domain rdf:resource="#Flight"/>
  <rdfs:range rdf:resource="#Airline"/>
  <rdfs:label xml:lang="en">operated by</rdfs:label>
  <rdfs:label xml:lang="el">εκτελείται από</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#manages">
  <rdfs:range rdf:resource="#AgencyBranch"/>
  <rdfs:domain rdf:resource="#Manager"/>
  <rdfs:subPropertyOf rdf:resource="#worksFor"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:label xml:lang="el">διευθύνει</rdfs:label>
  <rdfs:comment xml:lang="el">Υπο-ιδιότητα του worksFor: όποιος διευθύνει ένα υποκατάστημα εργάζεται σε αυτό. Κάθε υποκατάστημα έχει το πολύ έναν διευθυντή.</rdfs:comment>
  <rdfs:label xml:lang="en">manages</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#worksFor">
  <rdfs:range rdf:resource="#AgencyBranch"/>
  <owl:inverseOf rdf:resource="#employs"/>
  <rdfs:domain rdf:resource="#Employee"/>
  <rdfs:label xml:lang="el">εργάζεται σε</rdfs:label>
  <rdfs:label xml:lang="en">works for</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#visitsPlace">
  <rdfs:domain rdf:resource="#HolidayPackage"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#hasDestination"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#locatedIn"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:range rdf:resource="#Place"/>
  <rdfs:comment xml:lang="el">Υπερ-ιδιότητα του hasDestination και αλυσίδα hasDestination ∘ locatedIn: ένα πακέτο «επισκέπτεται» τον προορισμό του και όλες τις τοποθεσίες που τον περιέχουν (περιοχή, χώρα).</rdfs:comment>
  <rdfs:label xml:lang="en">visits place</rdfs:label>
  <rdfs:label xml:lang="el">επισκέπτεται τοποθεσία</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#servedBy">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#hasBooking"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
          <rdf:first rdf:resource="#handledBy"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:domain rdf:resource="#Customer"/>
  <rdfs:range rdf:resource="#TravelAgent"/>
  <rdfs:label xml:lang="el">εξυπηρετήθηκε από</rdfs:label>
  <rdfs:label xml:lang="en">served by</rdfs:label>
  <rdfs:comment xml:lang="el">Αλυσίδα ιδιοτήτων: αν ο πελάτης έχει κράτηση που διεκπεραίωσε ο σύμβουλος Χ, τότε εξυπηρετήθηκε από τον Χ.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#travelsWith">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdfs:range rdf:resource="#Customer"/>
  <rdfs:domain rdf:resource="#Customer"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:label xml:lang="en">travels with</rdfs:label>
  <rdfs:label xml:lang="el">ταξιδεύει μαζί με</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasPayment">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:domain rdf:resource="#Booking"/>
  <rdfs:range rdf:resource="#Payment"/>
  <rdfs:label xml:lang="en">has payment</rdfs:label>
  <rdfs:label xml:lang="el">έχει πληρωμή</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#handledBy">
  <rdfs:range rdf:resource="#TravelAgent"/>
  <rdfs:domain rdf:resource="#Booking"/>
  <rdfs:label xml:lang="en">handled by</rdfs:label>
  <rdfs:label xml:lang="el">διεκπεραιώθηκε από</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#writesReview">
  <rdfs:domain rdf:resource="#Customer"/>
  <rdfs:range rdf:resource="#Review"/>
  <rdfs:label xml:lang="el">γράφει αξιολόγηση</rdfs:label>
  <rdfs:label xml:lang="en">writes review</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#promotedBy">
  <rdfs:range rdf:resource="#MarketingCampaign"/>
  <rdfs:domain rdf:resource="#HolidayPackage"/>
  <rdfs:label xml:lang="el">προβάλλεται από</rdfs:label>
  <rdfs:label xml:lang="en">promoted by</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasGuide">
  <rdfs:range rdf:resource="#TourGuide"/>
  <owl:inverseOf rdf:resource="#guides"/>
  <rdfs:comment xml:lang="el">Χωρίς domain: χρησιμοποιείται για εκδρομές, αλλά και ως περιορισμός στον ορισμό του GuidedPackage.</rdfs:comment>
  <rdfs:label xml:lang="el">έχει οδηγό/συνοδό</rdfs:label>
  <rdfs:label xml:lang="en">has guide</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#guides">
  <rdfs:domain rdf:resource="#TourGuide"/>
  <rdfs:label xml:lang="en">guides</rdfs:label>
  <rdfs:label xml:lang="el">συνοδεύει</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#offersPackage">
  <rdfs:range rdf:resource="#HolidayPackage"/>
  <rdfs:domain rdf:resource="#TravelAgency"/>
  <rdfs:label xml:lang="el">προσφέρει πακέτο</rdfs:label>
  <rdfs:label xml:lang="en">offers package</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#employs">
  <rdfs:range rdf:resource="#Employee"/>
  <rdfs:domain rdf:resource="#AgencyBranch"/>
  <rdfs:label xml:lang="el">απασχολεί</rdfs:label>
  <rdfs:label xml:lang="en">employs</rdfs:label>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#lastName">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Person"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:label xml:lang="el">επώνυμο</rdfs:label>
  <rdfs:label xml:lang="en">last name</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#salary">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Employee"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="el">μηνιαίος μισθός (€)</rdfs:label>
  <rdfs:label xml:lang="en">monthly salary (EUR)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#pricePerPerson">
  <rdfs:domain rdf:resource="#HolidayPackage"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:label xml:lang="en">price per person (EUR)</rdfs:label>
  <rdfs:label xml:lang="el">τιμή ανά άτομο (€)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#numberOfTravellers">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Booking"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
  <rdfs:label xml:lang="el">αριθμός ταξιδιωτών</rdfs:label>
  <rdfs:label xml:lang="en">number of travellers</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#rating">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:withRestrictions>
        <rdf:Description>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</xsd:maxInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
          <rdf:first>
            <rdf:Description>
              <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
            </rdf:Description>
          </rdf:first>
        </rdf:Description>
      </owl:withRestrictions>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:domain rdf:resource="#Review"/>
  <rdfs:label xml:lang="el">βαθμολογία (1-5)</rdfs:label>
  <rdfs:label xml:lang="en">rating (1-5)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#endDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdfs:domain rdf:resource="#MarketingCampaign"/>
  <rdfs:label xml:lang="en">end date</rdfs:label>
  <rdfs:label xml:lang="el">ημερομηνία λήξης</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#amount">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Payment"/>
  <rdfs:label xml:lang="el">ποσό (€)</rdfs:label>
  <rdfs:label xml:lang="en">amount (EUR)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#maxParticipants">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
  <rdfs:domain rdf:resource="#Excursion"/>
  <rdfs:label xml:lang="el">μέγιστος αριθμός συμμετεχόντων</rdfs:label>
  <rdfs:label xml:lang="en">max participants</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#durationDays">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#HolidayPackage"/>
  <rdfs:label xml:lang="el">διάρκεια (ημέρες)</rdfs:label>
  <rdfs:label xml:lang="en">duration (days)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#startDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdfs:domain rdf:resource="#MarketingCampaign"/>
  <rdfs:label xml:lang="en">start date</rdfs:label>
  <rdfs:label xml:lang="el">ημερομηνία έναρξης</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#iataCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Airport"/>
  <rdfs:label xml:lang="el">κωδικός IATA</rdfs:label>
  <rdfs:label xml:lang="en">IATA code</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#budget">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#MarketingCampaign"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="el">προϋπολογισμός (€)</rdfs:label>
  <rdfs:label xml:lang="en">budget (EUR)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#starRating">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:domain rdf:resource="#Hotel"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:label xml:lang="el">κατηγορία αστέρων</rdfs:label>
  <rdfs:label xml:lang="en">star rating</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#loyaltyPoints">
  <rdfs:domain rdf:resource="#Customer"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="en">loyalty points</rdfs:label>
  <rdfs:label xml:lang="el">πόντοι επιβράβευσης</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hireDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdfs:domain rdf:resource="#Employee"/>
  <rdfs:label xml:lang="en">hire date</rdfs:label>
  <rdfs:label xml:lang="el">ημερομηνία πρόσληψης</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#reviewText">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Review"/>
  <rdfs:label xml:lang="en">review text</rdfs:label>
  <rdfs:label xml:lang="el">κείμενο αξιολόγησης</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#departureDate">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:label xml:lang="en">departure date</rdfs:label>
  <rdfs:label xml:lang="el">ημερομηνία αναχώρησης</rdfs:label>
  <rdfs:comment xml:lang="el">Για πακέτα και πτήσεις.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#name">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="el">όνομα</rdfs:label>
  <rdfs:comment xml:lang="el">Ονομασία οργανισμού, τοποθεσίας, πακέτου, υπηρεσίας κ.λπ.</rdfs:comment>
  <rdfs:label xml:lang="en">name</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#email">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="el">ηλεκτρονική διεύθυνση</rdfs:label>
  <rdfs:label xml:lang="en">email</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#bookingDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Booking"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdfs:label xml:lang="el">ημερομηνία κράτησης</rdfs:label>
  <rdfs:label xml:lang="en">booking date</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#flightNumber">
  <rdfs:domain rdf:resource="#Flight"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="en">flight number</rdfs:label>
  <rdfs:label xml:lang="el">αριθμός πτήσης</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#firstName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:label xml:lang="el">όνομα</rdfs:label>
  <rdfs:label xml:lang="en">first name</rdfs:label>
</owl:DatatypeProperty>

<owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>

<owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>

<owl:Class rdf:about="#Port">
  <rdfs:subClassOf rdf:resource="#Place"/>
  <rdfs:label xml:lang="el">Λιμάνι</rdfs:label>
  <rdfs:label xml:lang="en">Port</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Customer">
  <rdfs:subClassOf rdf:resource="#Person"/>
  <rdfs:label xml:lang="el">Πελάτης</rdfs:label>
  <rdfs:label xml:lang="en">Customer</rdfs:label>
  <rdfs:comment xml:lang="el">Πρόσωπο που κάνει κρατήσεις πακέτων διακοπών.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MarketingSpecialist">
  <rdfs:subClassOf rdf:resource="#Employee"/>
  <rdfs:label xml:lang="en">Marketing Specialist</rdfs:label>
  <rdfs:label xml:lang="el">Υπεύθυνος Προβολής</rdfs:label>
  <rdfs:comment xml:lang="el">Υπάλληλος που σχεδιάζει διαφημιστικές καμπάνιες.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Excursion">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#visitsDestination"/>
      <owl:someValuesFrom rdf:resource="#Destination"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="#TourGuide"/>
      <owl:onProperty rdf:resource="#hasGuide"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#TravelService"/>
  <rdfs:label xml:lang="el">Οργανωμένη Εκδρομή</rdfs:label>
  <rdfs:comment xml:lang="el">Κάθε οργανωμένη εκδρομή έχει τουλάχιστον έναν οδηγό/συνοδό (ακόμη κι αν δεν είναι γνωστός ποιος).</rdfs:comment>
  <rdfs:label xml:lang="en">Organised Excursion</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TravelAgency">
  <rdfs:subClassOf rdf:resource="#Organization"/>
  <rdfs:label xml:lang="el">Ταξιδιωτικό Πρακτορείο</rdfs:label>
  <rdfs:label xml:lang="en">Travel Agency</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#IslandDestination">
  <rdfs:subClassOf rdf:resource="#Destination"/>
  <rdfs:label xml:lang="en">Island Destination</rdfs:label>
  <rdfs:label xml:lang="el">Νησιωτικός Προορισμός</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AgencyBranch">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#branchOf"/>
      <owl:onClass rdf:resource="#TravelAgency"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#Organization"/>
  <rdfs:label xml:lang="en">Agency Branch</rdfs:label>
  <rdfs:comment xml:lang="el">Κάθε υποκατάστημα ανήκει σε ακριβώς ένα πρακτορείο.</rdfs:comment>
  <rdfs:label xml:lang="el">Υποκατάστημα</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Booking">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#bookedBy"/>
      <owl:onClass rdf:resource="#Customer"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#forPackage"/>
      <owl:onClass rdf:resource="#HolidayPackage"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onClass rdf:resource="#BookingStatus"/>
      <owl:onProperty rdf:resource="#hasStatus"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="el">Κράτηση</rdfs:label>
  <rdfs:comment xml:lang="el">Κράτηση ενός πακέτου από ακριβώς έναν πελάτη, με ακριβώς μία κατάσταση.</rdfs:comment>
  <rdfs:label xml:lang="en">Booking</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Employee">
  <rdfs:subClassOf rdf:resource="#Person"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="#AgencyBranch"/>
      <owl:onProperty rdf:resource="#worksFor"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="el">Υπάλληλος</rdfs:label>
  <rdfs:comment xml:lang="el">Μέλος του προσωπικού του πρακτορείου· εργάζεται σε τουλάχιστον ένα υποκατάστημα.</rdfs:comment>
  <rdfs:label xml:lang="en">Employee</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Person">
  <rdfs:label xml:lang="en">Person</rdfs:label>
  <rdfs:label xml:lang="el">Πρόσωπο</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MarketingCampaign">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#usesChannel"/>
      <owl:someValuesFrom rdf:resource="#AdvertisingChannel"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#promotes"/>
      <owl:someValuesFrom rdf:resource="#HolidayPackage"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="el">Διαφημιστική Καμπάνια</rdfs:label>
  <rdfs:label xml:lang="en">Marketing Campaign</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#HolidayPackage">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#pricePerPerson"/>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="#Accommodation"/>
      <owl:onProperty rdf:resource="#includesService"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="#Destination"/>
      <owl:onProperty rdf:resource="#hasDestination"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="el">Πακέτο Διακοπών</rdfs:label>
  <rdfs:comment xml:lang="el">Πακέτο με τουλάχιστον έναν προορισμό, τουλάχιστον ένα κατάλυμα και ακριβώς μία τιμή ανά άτομο.</rdfs:comment>
  <rdfs:label xml:lang="en">Holiday Package</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Transfer">
  <rdfs:subClassOf rdf:resource="#Transport"/>
  <rdfs:label xml:lang="en">Transfer</rdfs:label>
  <rdfs:label xml:lang="el">Οδική Μεταφορά (Transfer)</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Transport">
  <rdfs:subClassOf rdf:resource="#TravelService"/>
  <rdfs:label xml:lang="en">Transport</rdfs:label>
  <rdfs:label xml:lang="el">Μεταφορά</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Flight">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onClass rdf:resource="#Airline"/>
      <owl:onProperty rdf:resource="#operatedBy"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#Transport"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#arrivesAt"/>
      <owl:onClass rdf:resource="#Airport"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onClass rdf:resource="#Airport"/>
      <owl:onProperty rdf:resource="#departsFrom"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="el">Πτήση</rdfs:label>
  <rdfs:label xml:lang="en">Flight</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#CashPayment">
  <rdfs:subClassOf rdf:resource="#Payment"/>
  <rdfs:label xml:lang="el">Πληρωμή με Μετρητά</rdfs:label>
  <rdfs:label xml:lang="en">Cash Payment</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Payment">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#amount"/>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="el">Πληρωμή</rdfs:label>
  <rdfs:label xml:lang="en">Payment</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MountainDestination">
  <rdfs:subClassOf rdf:resource="#Destination"/>
  <rdfs:label xml:lang="el">Ορεινός Προορισμός</rdfs:label>
  <rdfs:label xml:lang="en">Mountain Destination</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TravelInsurance">
  <rdfs:subClassOf rdf:resource="#TravelService"/>
  <rdfs:label xml:lang="en">Travel Insurance</rdfs:label>
  <rdfs:label xml:lang="el">Ταξιδιωτική Ασφάλιση</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Place">
  <rdfs:label xml:lang="en">Place</rdfs:label>
  <rdfs:label xml:lang="el">Τοποθεσία</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Airport">
  <rdfs:subClassOf rdf:resource="#Place"/>
  <rdfs:label xml:lang="el">Αεροδρόμιο</rdfs:label>
  <rdfs:label xml:lang="en">Airport</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TravelAgent">
  <rdfs:subClassOf rdf:resource="#Employee"/>
  <rdfs:label xml:lang="en">Travel Agent</rdfs:label>
  <rdfs:label xml:lang="el">Ταξιδιωτικός Σύμβουλος</rdfs:label>
  <rdfs:comment xml:lang="el">Υπάλληλος που εξυπηρετεί πελάτες και διεκπεραιώνει κρατήσεις.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CardPayment">
  <rdfs:subClassOf rdf:resource="#Payment"/>
  <rdfs:label xml:lang="el">Πληρωμή με Κάρτα</rdfs:label>
  <rdfs:label xml:lang="en">Card Payment</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#LongStayPackage">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#HolidayPackage"/>
        <owl:Restriction>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                </rdf:Description>
              </owl:withRestrictions>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </rdfs:Datatype>
          </owl:someValuesFrom>
          <owl:onProperty rdf:resource="#durationDays"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="en">Long Stay Package</rdfs:label>
  <rdfs:comment xml:lang="el">Ορισμένη κλάση: πακέτο διάρκειας τουλάχιστον 7 ημερών.</rdfs:comment>
  <rdfs:label xml:lang="el">Πακέτο Μεγάλης Διάρκειας</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BookingStatus">
  <owl:equivalentClass>
    <owl:Class>
      <owl:oneOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Confirmed"/>
        <rdf:Description rdf:about="#Pending"/>
        <rdf:Description rdf:about="#Cancelled"/>
      </owl:oneOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="en">Booking Status</rdfs:label>
  <rdfs:comment xml:lang="el">Απαριθμητή κλάση με τρεις τιμές.</rdfs:comment>
  <rdfs:label xml:lang="el">Κατάσταση Κράτησης</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Destination">
  <rdfs:subClassOf rdf:resource="#Place"/>
  <rdfs:label xml:lang="en">Destination</rdfs:label>
  <rdfs:comment xml:lang="el">Τοποθεσία στην οποία το πρακτορείο οργανώνει ταξίδια.</rdfs:comment>
  <rdfs:label xml:lang="el">Προορισμός</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Manager">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#manages"/>
      <owl:someValuesFrom rdf:resource="#AgencyBranch"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#Employee"/>
  <rdfs:comment xml:lang="el">Υπάλληλος που διευθύνει υποκατάστημα. Δεν δηλώνεται ξένη με τις άλλες υποκλάσεις του Employee: ένας διευθυντής μπορεί να είναι και σύμβουλος.</rdfs:comment>
  <rdfs:label xml:lang="el">Διευθυντής Υποκαταστήματος</rdfs:label>
  <rdfs:label xml:lang="en">Manager</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Region">
  <rdfs:subClassOf rdf:resource="#Place"/>
  <rdfs:label xml:lang="el">Περιφέρεια / Περιοχή</rdfs:label>
  <rdfs:label xml:lang="en">Region</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Language">
  <rdfs:label xml:lang="el">Γλώσσα</rdfs:label>
  <rdfs:label xml:lang="en">Language</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Review">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#reviews"/>
      <owl:onClass rdf:resource="#HolidayPackage"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onClass rdf:resource="#Customer"/>
      <owl:onProperty rdf:resource="#writtenBy"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="en">Review</rdfs:label>
  <rdfs:label xml:lang="el">Αξιολόγηση</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Airline">
  <rdfs:subClassOf rdf:resource="#Organization"/>
  <rdfs:label xml:lang="el">Αεροπορική Εταιρεία</rdfs:label>
  <rdfs:label xml:lang="en">Airline</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Accommodation">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#locatedIn"/>
      <owl:someValuesFrom rdf:resource="#Destination"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#TravelService"/>
  <rdfs:label xml:lang="en">Accommodation</rdfs:label>
  <rdfs:label xml:lang="el">Κατάλυμα</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TravelService">
  <rdfs:label xml:lang="el">Ταξιδιωτική Υπηρεσία</rdfs:label>
  <rdfs:label xml:lang="en">Travel Service</rdfs:label>
  <rdfs:comment xml:lang="el">Συστατικό ενός πακέτου διακοπών (διαμονή, μεταφορά, εκδρομή, ασφάλεια).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GuidedPackage">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#HolidayPackage"/>
        <owl:Restriction>
          <owl:someValuesFrom>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#hasGuide"/>
              <owl:someValuesFrom rdf:resource="#TourGuide"/>
            </owl:Restriction>
          </owl:someValuesFrom>
          <owl:onProperty rdf:resource="#includesService"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="en">Guided Package</rdfs:label>
  <rdfs:comment xml:lang="el">Ορισμένη κλάση: πακέτο που περιλαμβάνει υπηρεσία με οδηγό/συνοδό.</rdfs:comment>
  <rdfs:label xml:lang="el">Πακέτο με Συνοδό</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TourGuide">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#speaksLanguage"/>
      <owl:someValuesFrom rdf:resource="#Language"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#Employee"/>
  <rdfs:label xml:lang="el">Οδηγός / Συνοδός</rdfs:label>
  <rdfs:label xml:lang="en">Tour Guide</rdfs:label>
  <rdfs:comment xml:lang="el">Συνοδός ή ξεναγός οργανωμένων εκδρομών· μιλά τουλάχιστον μία γλώσσα.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FerryTrip">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="#Port"/>
      <owl:onProperty rdf:resource="#departsFrom"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#Transport"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#arrivesAt"/>
      <owl:someValuesFrom rdf:resource="#Port"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="el">Ακτοπλοϊκή Μετακίνηση</rdfs:label>
  <rdfs:label xml:lang="en">Ferry Trip</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Hotel">
  <rdfs:subClassOf rdf:resource="#Accommodation"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:rest>
                <rdf:Description>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</xsd:maxInclusive>
                    </rdf:Description>
                  </rdf:first>
                </rdf:Description>
              </rdf:rest>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
            </rdf:Description>
          </owl:withRestrictions>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        </rdfs:Datatype>
      </owl:someValuesFrom>
      <owl:onProperty rdf:resource="#starRating"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="en">Hotel</rdfs:label>
  <rdfs:label xml:lang="el">Ξενοδοχείο</rdfs:label>
  <rdfs:comment xml:lang="el">Ξενοδοχείο με κατηγορία αστέρων 1–5.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FlightPackage">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#HolidayPackage"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#includesService"/>
          <owl:someValuesFrom rdf:resource="#Flight"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="el">Πακέτο με Πτήση</rdfs:label>
  <rdfs:comment xml:lang="el">Ορισμένη κλάση: πακέτο που περιλαμβάνει τουλάχιστον μία πτήση.</rdfs:comment>
  <rdfs:label xml:lang="en">Flight Package</rdfs:label>
</owl:Class>

