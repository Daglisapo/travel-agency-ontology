<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency-inferred"
         xmlns="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency-inferred#"
         xmlns:trav="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#"
         xmlns:dc="http://purl.org/dc/elements/1.1/">

<owl:Ontology rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency-inferred">
  <rdfs:comment xml:lang="el">Η οντολογία travel_agency.owl μαζί με τα συμπεράσματα του reasoner Pellet (τύποι στιγμιοτύπων και τιμές ιδιοτήτων), παραγόμενη από το scripts/reason.py.</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#hasDestination">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
  <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#visitsPlace"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Destination"/>
  <rdfs:label xml:lang="en">has destination</rdfs:label>
  <rdfs:label xml:lang="el">έχει προορισμό</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#hasBooking">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Customer"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Booking"/>
  <owl:inverseOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#bookedBy"/>
  <rdfs:label xml:lang="en">has booking</rdfs:label>
  <rdfs:label xml:lang="el">έχει κράτηση</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#reviews">
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Review"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:label xml:lang="en">reviews</rdfs:label>
  <rdfs:label xml:lang="el">αξιολογεί</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#speaksLanguage">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Person"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Language"/>
  <rdfs:label xml:lang="el">μιλά γλώσσα</rdfs:label>
  <rdfs:label xml:lang="en">speaks language</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#arrivesAt">
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Place"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Transport"/>
  <rdfs:label xml:lang="el">φτάνει σε</rdfs:label>
  <rdfs:label xml:lang="en">arrives at</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#handledBy">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Booking"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TravelAgent"/>
  <rdfs:label xml:lang="en">handled by</rdfs:label>
  <rdfs:label xml:lang="el">διεκπεραιώθηκε από</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#hasPayment">
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Payment"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Booking"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:label xml:lang="en">has payment</rdfs:label>
  <rdfs:label xml:lang="el">έχει πληρωμή</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#forPackage">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Booking"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
  <rdfs:label xml:lang="en">for package</rdfs:label>
  <rdfs:label xml:lang="el">αφορά πακέτο</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#servedBy">
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TravelAgent"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#handledBy"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
      <rdf:first rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#hasBooking"/>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Customer"/>
  <rdfs:label xml:lang="en">served by</rdfs:label>
  <rdfs:comment xml:lang="el">Αλυσίδα ιδιοτήτων: αν ο πελάτης έχει κράτηση που διεκπεραίωσε ο σύμβουλος Χ, τότε εξυπηρετήθηκε από τον Χ.</rdfs:comment>
  <rdfs:label xml:lang="el">εξυπηρετήθηκε από</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#branchOf">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#AgencyBranch"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TravelAgency"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <owl:inverseOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#hasBranch"/>
  <rdfs:label xml:lang="el">υποκατάστημα του</rdfs:label>
  <rdfs:label xml:lang="en">branch of</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#visitsPlace">
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Place"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#hasDestination"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#locatedIn"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment xml:lang="el">Υπερ-ιδιότητα του hasDestination και αλυσίδα hasDestination ∘ locatedIn: ένα πακέτο «επισκέπτεται» τον προορισμό του και όλες τις τοποθεσίες που τον περιέχουν (περιοχή, χώρα).</rdfs:comment>
  <rdfs:label xml:lang="en">visits place</rdfs:label>
  <rdfs:label xml:lang="el">επισκέπτεται τοποθεσία</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#offersPackage">
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TravelAgency"/>
  <rdfs:label xml:lang="el">προσφέρει πακέτο</rdfs:label>
  <rdfs:label xml:lang="en">offers package</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#writesReview">
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Review"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Customer"/>
  <rdfs:label xml:lang="en">writes review</rdfs:label>
  <rdfs:label xml:lang="el">γράφει αξιολόγηση</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#writtenBy">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <owl:inverseOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#writesReview"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Customer"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Review"/>
  <rdfs:label xml:lang="en">written by</rdfs:label>
  <rdfs:label xml:lang="el">γράφτηκε από</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#employs">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#AgencyBranch"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Employee"/>
  <rdfs:label xml:lang="en">employs</rdfs:label>
  <rdfs:label xml:lang="el">απασχολεί</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#createdBy">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#MarketingCampaign"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#MarketingSpecialist"/>
  <rdfs:label xml:lang="el">σχεδιάστηκε από</rdfs:label>
  <rdfs:label xml:lang="en">created by</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#offeredBy">
  <owl:inverseOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#offersPackage"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TravelAgency"/>
  <rdfs:label xml:lang="el">προσφέρεται από</rdfs:label>
  <rdfs:label xml:lang="en">offered by</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#bookedBy">
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Customer"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Booking"/>
  <rdfs:label xml:lang="en">booked by</rdfs:label>
  <rdfs:label xml:lang="el">κρατήθηκε από</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#locatedIn">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Place"/>
  <rdfs:comment xml:lang="el">Μεταβατική: αν η Οία βρίσκεται στη Σαντορίνη και η Σαντορίνη στις Κυκλάδες, τότε η Οία βρίσκεται στις Κυκλάδες. Χρησιμοποιείται για τοποθεσίες, καταλύματα και υποκαταστήματα (χωρίς domain).</rdfs:comment>
  <rdfs:label xml:lang="en">located in</rdfs:label>
  <rdfs:label xml:lang="el">βρίσκεται σε</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#worksFor">
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#AgencyBranch"/>
  <owl:inverseOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#employs"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Employee"/>
  <rdfs:label xml:lang="el">εργάζεται σε</rdfs:label>
  <rdfs:label xml:lang="en">works for</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#travelsWith">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Customer"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Customer"/>
  <rdfs:label xml:lang="el">ταξιδεύει μαζί με</rdfs:label>
  <rdfs:label xml:lang="en">travels with</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#includesService">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TravelService"/>
  <rdfs:label xml:lang="el">περιλαμβάνει υπηρεσία</rdfs:label>
  <rdfs:label xml:lang="en">includes service</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#hasGuide">
  <owl:inverseOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#guides"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TourGuide"/>
  <rdfs:label xml:lang="el">έχει οδηγό/συνοδό</rdfs:label>
  <rdfs:comment xml:lang="el">Χωρίς domain: χρησιμοποιείται για εκδρομές, αλλά και ως περιορισμός στον ορισμό του GuidedPackage.</rdfs:comment>
  <rdfs:label xml:lang="en">has guide</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#manages">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Manager"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#AgencyBranch"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#worksFor"/>
  <rdfs:label xml:lang="el">διευθύνει</rdfs:label>
  <rdfs:comment xml:lang="el">Υπο-ιδιότητα του worksFor: όποιος διευθύνει ένα υποκατάστημα εργάζεται σε αυτό. Κάθε υποκατάστημα έχει το πολύ έναν διευθυντή.</rdfs:comment>
  <rdfs:label xml:lang="en">manages</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#usesChannel">
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#AdvertisingChannel"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#MarketingCampaign"/>
  <rdfs:label xml:lang="en">uses channel</rdfs:label>
  <rdfs:label xml:lang="el">χρησιμοποιεί κανάλι</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#hasStatus">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#BookingStatus"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Booking"/>
  <rdfs:label xml:lang="el">έχει κατάσταση</rdfs:label>
  <rdfs:label xml:lang="en">has status</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#departsFrom">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Transport"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Place"/>
  <rdfs:label xml:lang="en">departs from</rdfs:label>
  <rdfs:label xml:lang="el">αναχωρεί από</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#promotedBy">
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#MarketingCampaign"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
  <rdfs:label xml:lang="en">promoted by</rdfs:label>
  <rdfs:label xml:lang="el">προβάλλεται από</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#hasBranch">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TravelAgency"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#AgencyBranch"/>
  <rdfs:label xml:lang="el">έχει υποκατάστημα</rdfs:label>
  <rdfs:label xml:lang="en">has branch</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#visitsDestination">
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Destination"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Excursion"/>
  <rdfs:label xml:lang="en">visits destination</rdfs:label>
  <rdfs:label xml:lang="el">επισκέπτεται προορισμό</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#promotes">
  <owl:inverseOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#promotedBy"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#MarketingCampaign"/>
  <rdfs:label xml:lang="el">προβάλλει</rdfs:label>
  <rdfs:label xml:lang="en">promotes</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#guides">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TourGuide"/>
  <rdfs:label xml:lang="el">συνοδεύει</rdfs:label>
  <rdfs:label xml:lang="en">guides</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#operatedBy">
  <rdfs:range rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Airline"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Flight"/>
  <rdfs:label xml:lang="el">εκτελείται από</rdfs:label>
  <rdfs:label xml:lang="en">operated by</rdfs:label>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#iataCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Airport"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="el">κωδικός IATA</rdfs:label>
  <rdfs:label xml:lang="en">IATA code</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#startDate">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#MarketingCampaign"/>
  <rdfs:label xml:lang="en">start date</rdfs:label>
  <rdfs:label xml:lang="el">ημερομηνία έναρξης</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#loyaltyPoints">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Customer"/>
  <rdfs:label xml:lang="en">loyalty points</rdfs:label>
  <rdfs:label xml:lang="el">πόντοι επιβράβευσης</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#amount">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Payment"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="en">amount (EUR)</rdfs:label>
  <rdfs:label xml:lang="el">ποσό (€)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#durationDays">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
  <rdfs:label xml:lang="en">duration (days)</rdfs:label>
  <rdfs:label xml:lang="el">διάρκεια (ημέρες)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#bookingDate">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Booking"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdfs:label xml:lang="el">ημερομηνία κράτησης</rdfs:label>
  <rdfs:label xml:lang="en">booking date</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#rating">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Review"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:withRestrictions>
        <rdf:Description>
          <rdf:first>
            <rdf:Description>
              <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
            </rdf:Description>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
              <rdf:first>
                <rdf:Description>
                  <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</xsd:maxInclusive>
                </rdf:Description>
              </rdf:first>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </owl:withRestrictions>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:label xml:lang="el">βαθμολογία (1-5)</rdfs:label>
  <rdfs:label xml:lang="en">rating (1-5)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#pricePerPerson">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
  <rdfs:label xml:lang="en">price per person (EUR)</rdfs:label>
  <rdfs:label xml:lang="el">τιμή ανά άτομο (€)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#flightNumber">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Flight"/>
  <rdfs:label xml:lang="en">flight number</rdfs:label>
  <rdfs:label xml:lang="el">αριθμός πτήσης</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#numberOfTravellers">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Booking"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
  <rdfs:label xml:lang="en">number of travellers</rdfs:label>
  <rdfs:label xml:lang="el">αριθμός ταξιδιωτών</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#salary">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Employee"/>
  <rdfs:label xml:lang="en">monthly salary (EUR)</rdfs:label>
  <rdfs:label xml:lang="el">μηνιαίος μισθός (€)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#firstName">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Person"/>
  <rdfs:label xml:lang="el">όνομα</rdfs:label>
  <rdfs:label xml:lang="en">first name</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#name">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="el">όνομα</rdfs:label>
  <rdfs:comment xml:lang="el">Ονομασία οργανισμού, τοποθεσίας, πακέτου, υπηρεσίας κ.λπ.</rdfs:comment>
  <rdfs:label xml:lang="en">name</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#reviewText">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Review"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="en">review text</rdfs:label>
  <rdfs:label xml:lang="el">κείμενο αξιολόγησης</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#hireDate">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Employee"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdfs:label xml:lang="en">hire date</rdfs:label>
  <rdfs:label xml:lang="el">ημερομηνία πρόσληψης</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#departureDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdfs:label xml:lang="en">departure date</rdfs:label>
  <rdfs:label xml:lang="el">ημερομηνία αναχώρησης</rdfs:label>
  <rdfs:comment xml:lang="el">Για πακέτα και πτήσεις.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#lastName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Person"/>
  <rdfs:label xml:lang="en">last name</rdfs:label>
  <rdfs:label xml:lang="el">επώνυμο</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#budget">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#MarketingCampaign"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:label xml:lang="el">προϋπολογισμός (€)</rdfs:label>
  <rdfs:label xml:lang="en">budget (EUR)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#endDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#MarketingCampaign"/>
  <rdfs:label xml:lang="en">end date</rdfs:label>
  <rdfs:label xml:lang="el">ημερομηνία λήξης</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#maxParticipants">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Excursion"/>
  <rdfs:label xml:lang="en">max participants</rdfs:label>
  <rdfs:label xml:lang="el">μέγιστος αριθμός συμμετεχόντων</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#email">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Person"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="el">ηλεκτρονική διεύθυνση</rdfs:label>
  <rdfs:label xml:lang="en">email</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#starRating">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Hotel"/>
  <rdfs:label xml:lang="en">star rating</rdfs:label>
  <rdfs:label xml:lang="el">κατηγορία αστέρων</rdfs:label>
</owl:DatatypeProperty>

<owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>

<owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Excursion">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Destination"/>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#visitsDestination"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TravelService"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#hasGuide"/>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TourGuide"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment xml:lang="el">Κάθε οργανωμένη εκδρομή έχει τουλάχιστον έναν οδηγό/συνοδό (ακόμη κι αν δεν είναι γνωστός ποιος).</rdfs:comment>
  <rdfs:label xml:lang="en">Organised Excursion</rdfs:label>
  <rdfs:label xml:lang="el">Οργανωμένη Εκδρομή</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Booking">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#bookedBy"/>
      <owl:onClass rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Customer"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onClass rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#forPackage"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#hasStatus"/>
      <owl:onClass rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#BookingStatus"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="el">Κράτηση</rdfs:label>
  <rdfs:comment xml:lang="el">Κράτηση ενός πακέτου από ακριβώς έναν πελάτη, με ακριβώς μία κατάσταση.</rdfs:comment>
  <rdfs:label xml:lang="en">Booking</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#AdvertisingChannel">
  <rdfs:label xml:lang="el">Διαφημιστικό Κανάλι</rdfs:label>
  <rdfs:label xml:lang="en">Advertising Channel</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Accommodation"/>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#includesService"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Destination"/>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#hasDestination"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#pricePerPerson"/>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="en">Holiday Package</rdfs:label>
  <rdfs:label xml:lang="el">Πακέτο Διακοπών</rdfs:label>
  <rdfs:comment xml:lang="el">Πακέτο με τουλάχιστον έναν προορισμό, τουλάχιστον ένα κατάλυμα και ακριβώς μία τιμή ανά άτομο.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Airport">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Place"/>
  <rdfs:label xml:lang="el">Αεροδρόμιο</rdfs:label>
  <rdfs:label xml:lang="en">Airport</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Place">
  <rdfs:label xml:lang="el">Τοποθεσία</rdfs:label>
  <rdfs:label xml:lang="en">Place</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#BookingStatus">
  <owl:equivalentClass>
    <owl:Class>
      <owl:oneOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Confirmed"/>
        <rdf:Description rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Pending"/>
        <rdf:Description rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Cancelled"/>
      </owl:oneOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment xml:lang="el">Απαριθμητή κλάση με τρεις τιμές.</rdfs:comment>
  <rdfs:label xml:lang="el">Κατάσταση Κράτησης</rdfs:label>
  <rdfs:label xml:lang="en">Booking Status</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#GuidedPackage">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
        <owl:Restriction>
          <owl:someValuesFrom>
            <owl:Restriction>
              <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TourGuide"/>
              <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#hasGuide"/>
            </owl:Restriction>
          </owl:someValuesFrom>
          <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#includesService"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
  <rdfs:label xml:lang="en">Guided Package</rdfs:label>
  <rdfs:comment xml:lang="el">Ορισμένη κλάση: πακέτο που περιλαμβάνει υπηρεσία με οδηγό/συνοδό.</rdfs:comment>
  <rdfs:label xml:lang="el">Πακέτο με Συνοδό</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#MountainDestination">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Destination"/>
  <rdfs:label xml:lang="el">Ορεινός Προορισμός</rdfs:label>
  <rdfs:label xml:lang="en">Mountain Destination</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Flight">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#operatedBy"/>
      <owl:onClass rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Airline"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Transport"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onClass rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Airport"/>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#arrivesAt"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onClass rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Airport"/>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#departsFrom"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="en">Flight</rdfs:label>
  <rdfs:label xml:lang="el">Πτήση</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Language">
  <rdfs:label xml:lang="el">Γλώσσα</rdfs:label>
  <rdfs:label xml:lang="en">Language</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#AgencyBranch">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onClass rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TravelAgency"/>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#branchOf"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Organization"/>
  <rdfs:comment xml:lang="el">Κάθε υποκατάστημα ανήκει σε ακριβώς ένα πρακτορείο.</rdfs:comment>
  <rdfs:label xml:lang="en">Agency Branch</rdfs:label>
  <rdfs:label xml:lang="el">Υποκατάστημα</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#FlightPackage">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#includesService"/>
          <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Flight"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
  <rdfs:comment xml:lang="el">Ορισμένη κλάση: πακέτο που περιλαμβάνει τουλάχιστον μία πτήση.</rdfs:comment>
  <rdfs:label xml:lang="el">Πακέτο με Πτήση</rdfs:label>
  <rdfs:label xml:lang="en">Flight Package</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Destination">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Place"/>
  <rdfs:label xml:lang="en">Destination</rdfs:label>
  <rdfs:comment xml:lang="el">Τοποθεσία στην οποία το πρακτορείο οργανώνει ταξίδια.</rdfs:comment>
  <rdfs:label xml:lang="el">Προορισμός</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Country">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Place"/>
  <rdfs:label xml:lang="en">Country</rdfs:label>
  <rdfs:label xml:lang="el">Χώρα</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Transport">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TravelService"/>
  <rdfs:label xml:lang="el">Μεταφορά</rdfs:label>
  <rdfs:label xml:lang="en">Transport</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Payment">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#amount"/>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="el">Πληρωμή</rdfs:label>
  <rdfs:label xml:lang="en">Payment</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TravelInsurance">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TravelService"/>
  <rdfs:label xml:lang="en">Travel Insurance</rdfs:label>
  <rdfs:label xml:lang="el">Ταξιδιωτική Ασφάλιση</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TravelService">
  <rdfs:label xml:lang="en">Travel Service</rdfs:label>
  <rdfs:comment xml:lang="el">Συστατικό ενός πακέτου διακοπών (διαμονή, μεταφορά, εκδρομή, ασφάλεια).</rdfs:comment>
  <rdfs:label xml:lang="el">Ταξιδιωτική Υπηρεσία</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TravelAgent">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Employee"/>
  <rdfs:label xml:lang="en">Travel Agent</rdfs:label>
  <rdfs:label xml:lang="el">Ταξιδιωτικός Σύμβουλος</rdfs:label>
  <rdfs:comment xml:lang="el">Υπάλληλος που εξυπηρετεί πελάτες και διεκπεραιώνει κρατήσεις.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Employee">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#worksFor"/>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#AgencyBranch"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Person"/>
  <rdfs:label xml:lang="en">Employee</rdfs:label>
  <rdfs:comment xml:lang="el">Μέλος του προσωπικού του πρακτορείου· εργάζεται σε τουλάχιστον ένα υποκατάστημα.</rdfs:comment>
  <rdfs:label xml:lang="el">Υπάλληλος</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Review">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onClass rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#reviews"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#writtenBy"/>
      <owl:onClass rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Customer"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="en">Review</rdfs:label>
  <rdfs:label xml:lang="el">Αξιολόγηση</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Transfer">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Transport"/>
  <rdfs:label xml:lang="en">Transfer</rdfs:label>
  <rdfs:label xml:lang="el">Οδική Μεταφορά (Transfer)</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Customer">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Person"/>
  <rdfs:label xml:lang="en">Customer</rdfs:label>
  <rdfs:comment xml:lang="el">Πρόσωπο που κάνει κρατήσεις πακέτων διακοπών.</rdfs:comment>
  <rdfs:label xml:lang="el">Πελάτης</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#VIPCustomer">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Customer"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#loyaltyPoints"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1000</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Customer"/>
  <rdfs:label xml:lang="en">VIP Customer</rdfs:label>
  <rdfs:label xml:lang="el">Πελάτης VIP</rdfs:label>
  <rdfs:comment xml:lang="el">Ορισμένη κλάση: πελάτης με τουλάχιστον 1000 πόντους επιβράβευσης. Τα μέλη της συνάγονται από τον reasoner.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Accommodation">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#locatedIn"/>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Destination"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TravelService"/>
  <rdfs:label xml:lang="en">Accommodation</rdfs:label>
  <rdfs:label xml:lang="el">Κατάλυμα</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TourGuide">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Employee"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Language"/>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#speaksLanguage"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="en">Tour Guide</rdfs:label>
  <rdfs:comment xml:lang="el">Συνοδός ή ξεναγός οργανωμένων εκδρομών· μιλά τουλάχιστον μία γλώσσα.</rdfs:comment>
  <rdfs:label xml:lang="el">Οδηγός / Συνοδός</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#MarketingCampaign">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#AdvertisingChannel"/>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#usesChannel"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#promotes"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="el">Διαφημιστική Καμπάνια</rdfs:label>
  <rdfs:label xml:lang="en">Marketing Campaign</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#IslandPackage">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
        <owl:Restriction>
          <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#IslandDestination"/>
          <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#hasDestination"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment xml:lang="el">Ορισμένη κλάση: πακέτο με τουλάχιστον έναν νησιωτικό προορισμό.</rdfs:comment>
  <rdfs:label xml:lang="el">Νησιωτικό Πακέτο</rdfs:label>
  <rdfs:label xml:lang="en">Island Package</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Manager">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#AgencyBranch"/>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#manages"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Employee"/>
  <rdfs:label xml:lang="en">Manager</rdfs:label>
  <rdfs:label xml:lang="el">Διευθυντής Υποκαταστήματος</rdfs:label>
  <rdfs:comment xml:lang="el">Υπάλληλος που διευθύνει υποκατάστημα. Δεν δηλώνεται ξένη με τις άλλες υποκλάσεις του Employee: ένας διευθυντής μπορεί να είναι και σύμβουλος.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#FerryTrip">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Port"/>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#arrivesAt"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Port"/>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#departsFrom"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Transport"/>
  <rdfs:label xml:lang="en">Ferry Trip</rdfs:label>
  <rdfs:label xml:lang="el">Ακτοπλοϊκή Μετακίνηση</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#LongStayPackage">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#HolidayPackage"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#durationDays"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="el">Πακέτο Μεγάλης Διάρκειας</rdfs:label>
  <rdfs:label xml:lang="en">Long Stay Package</rdfs:label>
  <rdfs:comment xml:lang="el">Ορισμένη κλάση: πακέτο διάρκειας τουλάχιστον 7 ημερών.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#BankTransfer">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Payment"/>
  <rdfs:label xml:lang="el">Τραπεζική Μεταφορά</rdfs:label>
  <rdfs:label xml:lang="en">Bank Transfer</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Port">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Place"/>
  <rdfs:label xml:lang="en">Port</rdfs:label>
  <rdfs:label xml:lang="el">Λιμάνι</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#MarketingSpecialist">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Employee"/>
  <rdfs:label xml:lang="el">Υπεύθυνος Προβολής</rdfs:label>
  <rdfs:label xml:lang="en">Marketing Specialist</rdfs:label>
  <rdfs:comment xml:lang="el">Υπάλληλος που σχεδιάζει διαφημιστικές καμπάνιες.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#CityDestination">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Destination"/>
  <rdfs:label xml:lang="el">Αστικός Προορισμός</rdfs:label>
  <rdfs:label xml:lang="en">City Destination</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Region">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Place"/>
  <rdfs:label xml:lang="en">Region</rdfs:label>
  <rdfs:label xml:lang="el">Περιφέρεια / Περιοχή</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#TravelAgency">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Organization"/>
  <rdfs:label xml:lang="el">Ταξιδιωτικό Πρακτορείο</rdfs:label>
  <rdfs:label xml:lang="en">Travel Agency</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#CardPayment">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Payment"/>
  <rdfs:label xml:lang="en">Card Payment</rdfs:label>
  <rdfs:label xml:lang="el">Πληρωμή με Κάρτα</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Person">
  <rdfs:label xml:lang="el">Πρόσωπο</rdfs:label>
  <rdfs:label xml:lang="en">Person</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Hotel">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Accommodation"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
          <owl:withRestrictions>
            <rdf:Description>
              <rdf:first>
                <rdf:Description>
                  <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                </rdf:Description>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</xsd:maxInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </owl:withRestrictions>
        </rdfs:Datatype>
      </owl:someValuesFrom>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#starRating"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label xml:lang="en">Hotel</rdfs:label>
  <rdfs:label xml:lang="el">Ξενοδοχείο</rdfs:label>
  <rdfs:comment xml:lang="el">Ξενοδοχείο με κατηγορία αστέρων 1–5.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/dagklis/ontologies/2026/travel-agency#Organization">
  <rdfs:label xml:lang="en">Organization</rdfs:label>
